{
  "name": "tracegrid",
  "version": "0.3.0",
  "description": "Map how your app code reaches your Supabase or Firebase backend: tables, RPCs, Security Rules, Cloud Functions, storage, grants and RLS. Static, offline, no AI.",
  "type": "module",
  "bin": {
    "tracegrid": "bin/tracegrid.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "skills",
    ".claude-plugin",
    "action.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "demo": "node bin/tracegrid.js --demo",
    "site": "node site/build.mjs",
    "stats": "node scripts/stats.mjs"
  },
  "keywords": [
    "supabase",
    "firebase",
    "firestore",
    "security-rules",
    "postgres",
    "rls",
    "static-analysis",
    "call-graph",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdanBarrios/tracegrid.git"
  },
  "homepage": "https://github.com/EdanBarrios/tracegrid#readme",
  "bugs": {
    "url": "https://github.com/EdanBarrios/tracegrid/issues"
  },
  "license": "MIT",
  "author": "Edan Barrios",
  "dependencies": {
    "typescript": "^5.4.0"
  }
}
